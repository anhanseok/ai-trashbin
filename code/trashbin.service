[Unit]
# 실제 수거함 자동 실행. 전원만 꽂으면 main.py 가 돌아간다. (먼저 python check.py 가 모두 ✅ 인지 확인)
# 설치:
#   sudo cp trashbin.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now trashbin.service
# 켜면 임시 heartbeat.service 는 자동으로 멈춘다 (Conflicts). 끄고 되돌리려면:
#   sudo systemctl disable --now trashbin.service && sudo systemctl enable --now heartbeat.service
Description=AI Trash Bin
After=network-online.target
Wants=network-online.target
Conflicts=heartbeat.service

[Service]
User=pi
WorkingDirectory=/home/pi/ai-trashbin/code
ExecStart=/home/pi/ai-trashbin/code/env/bin/python -u main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
